# openai-agentic-platform-engineering - environment
# Copy to .env (gitignored). Every use case reads this file from the repo root: the agents load it,
# the StackQL MCP server inherits it as its process environment, and stackql-deploy reads it via
# --env-file. Provider credentials follow StackQL's per-provider environment variable conventions.

# --- OpenAI ----------------------------------------------------------------------------------
OPENAI_API_KEY=
# Model tiering - never hardcoded in code. Change here when models change.
SWEEP_MODEL=gpt-5.4-mini          # mini tier: the scheduled sweep / classification loop
REASONING_MODEL=gpt-5.5           # frontier tier: escalated reasoning and remediation planning
SWEEP_REASONING_EFFORT=low        # minimal | low | medium | high
REASONING_REASONING_EFFORT=medium
# Optional: extend or override pricing.json (USD per 1M tokens) for the cost line, e.g.
# {"gpt-5.4-mini":{"input":0.75,"cached_input":0.075,"output":4.5}}
# OPENAI_PRICING_JSON=

# --- StackQL MCP server ------------------------------------------------------------------------
# Each use case spawns the server from its own package (PyPI stackql-mcp-server, npm
# @stackql/mcp-server, crates.io stackql-mcp). The binary is downloaded and sha256-verified on first
# run into ~/.stackql/mcp-server-bin/. Providers are pulled into the approot by `make setup`.
STACKQL_APPROOT=                  # optional; default ~/.stackql
STACKQL_MCP_AUDIT_LOG=runs/stackql-mcp-audit.jsonl   # every statement the server runs, jsonl, relative to the repo root
# STACKQL_MCP_BIN=                # optional: use an existing stackql binary instead of downloading

# --- Demo tenancy (enforced in queries and stacks, not just documented) --------------------------
DEMO_PREFIX=agentic-demo          # resource name prefix used by every stack
DEMO_TAG_KEY=purpose              # every stack tags/labels its resources with this
DEMO_TAG_VALUE=agentic-demo       # and every mutation asserts it on the target first

# --- AWS (finops, entitlements, drift) ----------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=                   # the dedicated demo account
AWS_REGION=ap-southeast-2         # primary demo region

# --- Azure (finops, entitlements, drift) and Microsoft Entra ID (entitlements) ------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=            # the dedicated demo subscription
AZURE_LOCATION=eastus2
# The entra_id provider reuses the three AZURE_* credentials. The app registration needs Microsoft
# Graph application permissions with admin consent: User.Read.All and Group.Read.All to audit;
# User.ReadWrite.All, Group.ReadWrite.All, GroupMember.ReadWrite.All to build the entitlements stack.

# --- Google Cloud (finops, entitlements) --------------------------------------------------------
GOOGLE_CREDENTIALS=               # service account key JSON on one line (StackQL google provider convention)
GOOGLE_PROJECT=                   # the dedicated demo project
GOOGLE_ZONE=us-central1-a

# --- GitHub (entitlements, edge) --------------------------------------------------------------
# StackQL github provider uses basic auth: username + personal access token
STACKQL_GITHUB_USERNAME=
STACKQL_GITHUB_PASSWORD=
GITHUB_ORG=                       # the demo org whose members and repos are audited

# --- Okta (entitlements alternative IdP; unused unless IDP_PROVIDER=okta) ----------------------
# OKTA_DOMAIN=dev-123456.okta.com
# OKTA_API_TOKEN=

# --- Cloudflare (edge) --------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=             # token with Zone:Read, Analytics:Read, Zone WAF:Edit on the demo zone
CLOUDFLARE_ZONE_ID=               # the dedicated demo zone
CLOUDFLARE_ACCOUNT_ID=

# --- Kubernetes (sre) ---------------------------------------------------------------------------
# A local kind cluster reached through `kubectl proxy --port=8001`; no credentials needed.
KUBE_CLUSTER_ADDR=localhost:8001
KUBE_PROTOCOL=http
K8S_NAMESPACE=agentic-demo

# --- finops --------------------------------------------------------------------------------------
SNAPSHOT_MAX_AGE_DAYS=30          # snapshots older than this are stale (query param)

# --- entitlements --------------------------------------------------------------------------------
IDP_PROVIDER=entra_id             # entra_id | okta - which IdP the joins run against
IDP_PRIVILEGED_GROUP=agentic-demo-cloud-admins   # the IdP group whose members are recertified
# AWS_IAM_REGION=us-east-1        # region the IAM queries sign against (default)
ESCALATION_SEVERITY=high          # findings at or above this go to REASONING_MODEL
# entitlements/stack/entra_id only (creating the disabled leaver user):
# ENTRA_TENANT_DOMAIN=contoso.onmicrosoft.com
# ENTRA_LEAVER_INITIAL_PASSWORD=   # never reused; the account is created disabled

# --- sre ------------------------------------------------------------------------------------------
# SRE_TARGET_DEPLOYMENT=          # default <DEMO_PREFIX>-checkout: the deployment the alert names and the gate may scale
# SRE_APP_LABEL=checkout          # `app` label selecting its pods
# SRE_VERIFY_TIMEOUT_SECS=120     # how long to poll for ready replicas after the mutation
# SRE_VERIFY_POLL_SECS=5

# --- drift ----------------------------------------------------------------------------------------
DRIFT_SNAPSHOT_DB=snapshots/drift.db   # local sqlite snapshot backend, relative to the repo root
# DRIFT_MAX_TOOL_CALLS=6          # cap on model tool calls per brief
# DRIFT_ROW_LIMIT=5000            # row_limit passed to run_select_query for snapshots

# --- edge -----------------------------------------------------------------------------------------
ELEVATED_RPS=5                    # requests/second at or above which the policy tightens
TIGHTENED_THRESHOLD=30            # requests per 10 s after tightening
BASELINE_THRESHOLD=100            # requests per 10 s the stack sets and `restore` puts back
WINDOW_MINUTES=30                 # recon window
# GITHUB_DECISIONS_REPO=owner/repo  # file the decision record as an issue via INSERT INTO github.issues.issues; unset -> jsonl
# EDGE_DECISIONS_LOG=runs/edge-decisions.jsonl
