# openai-agentic-platform-engineering - environment
# Copy to .env (gitignored). Every process in this repo reads this file:
# the agents (python-dotenv), the StackQL MCP server (--env.file), seed and
# teardown scripts, and stackql-deploy. Provider credentials follow StackQL's
# per-provider environment variable conventions.

# --- OpenAI (Agents SDK) ---------------------------------------------------
OPENAI_API_KEY=                 # project API key used by the agents
# Model tiering - never hardcoded in code. Change here when models change.
SWEEP_MODEL=gpt-5.4-mini        # mini tier: scheduled sweep / classification loop
REASONING_MODEL=gpt-5.5         # frontier tier: escalated reasoning and remediation planning
# Reasoning effort per tier (minimal|low|medium|high) - keeps sweep cost down
SWEEP_REASONING_EFFORT=low
REASONING_REASONING_EFFORT=medium
# Optional: pricing overrides as JSON, e.g. {"gpt-5.4-mini":{"input":0.75,"cached_input":0.075,"output":4.5}}
# Defaults live in config/pricing.yaml (USD per 1M tokens).
# OPENAI_PRICING_JSON=

# --- OpenAI org governance (closer scenario, seed/openai) -------------------
# Admin API key (sk-admin-...) from Organization settings -> Admin keys.
# Required by the openai_admin StackQL provider. Project keys return 403.
OPENAI_ADMIN_KEY=
OPENAI_ORG_ID=
OPENAI_KEY_MAX_AGE_DAYS=0       # threshold for "old" service account keys (0 = flag all, demo)

# --- StackQL ----------------------------------------------------------------
STACKQL_BIN=stackql             # binary on PATH, or absolute path
STACKQL_APPROOT=.stackql        # provider cache root (make setup pulls providers here)
STACKQL_MCP_AUDIT_LOG=runs/stackql-mcp-audit.jsonl
SNAPSHOT_DB=snapshots/estate.db # file-backed SQLite the drift snapshots materialize into

# --- Demo tenancy (enforced, not just documented) ---------------------------
# Every query is pinned to these identifiers and every mutation asserts the
# demo tag on its target before executing.
DEMO_TAG_KEY=purpose
DEMO_TAG_VALUE=oape-demo
DEMO_PREFIX=oape-demo           # resource name prefix used by seed/teardown

# --- AWS --------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=                 # the dedicated demo account; queries assert this
AWS_REGION=ap-southeast-2       # primary demo region

# --- Azure ------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=          # the dedicated demo subscription
AZURE_LOCATION=eastus2

# --- Google Cloud -----------------------------------------------------------
# Service account key JSON on one line (StackQL google provider convention)
GOOGLE_CREDENTIALS=
GOOGLE_PROJECT=                 # the dedicated demo project
GOOGLE_REGION=us-central1
GOOGLE_ZONE=us-central1-a

# --- GitHub -----------------------------------------------------------------
# StackQL github provider uses basic auth: username + PAT
STACKQL_GITHUB_USERNAME=
STACKQL_GITHUB_PASSWORD=
GITHUB_ORG=                     # the demo org (seed creates repos here; needs admin)
GITHUB_ISSUES_REPO=             # owner/repo where sweep findings are filed as issues
GITHUB_DEMO_COLLABORATOR=       # a second GitHub user account (not an org member) invited as admin on the demo repo
GITHUB_COLLABORATOR_TOKEN=      # that account's PAT (repo scope) so the seed can accept the invitation; leave both blank to skip
DEPLOY_KEY_MAX_AGE_DAYS=0       # threshold for "stale" deploy keys (0 = flag all, demo)

# --- IdP (Entra ID chosen - see WORK_ORDER.md for why and required Graph permissions) ---
# entra_id provider reuses AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET.
# The app registration needs Microsoft Graph application permissions:
#   User.ReadWrite.All, Group.ReadWrite.All, GroupMember.ReadWrite.All (seed + read)
# Okta alternative (unused unless OKTA_DOMAIN is set):
# OKTA_DOMAIN=dev-123456.okta.com
# OKTA_API_TOKEN=
IDP_PRIVILEGED_GROUP=oape-demo-cloud-admins

# --- Sweep behaviour ---------------------------------------------------------
ESCALATION_SEVERITY=high        # findings at or above this severity go to the reasoning tier
SWEEP_SCHEDULE_MINUTES=60       # scheduler interval for `make schedule`

# --- Drift and triage windows ------------------------------------------------
SNAPSHOT_MAX_AGE_DAYS=30        # FinOps: snapshots older than this are stale
RECENT_DEPLOY_HOURS=72          # triage: deployments within this window correlate with the alert
