/*+ exists */
WITH g AS (
  SELECT id, displayName AS display_name FROM entra_id.groups.groups
)
SELECT COUNT(*) AS count FROM g WHERE display_name = '{{ group_name }}'

/*+ create */
INSERT INTO entra_id.groups.groups (
  displayName,
  mailEnabled,
  mailNickname,
  securityEnabled,
  description
)
SELECT
  '{{ group_name }}',
  false,
  '{{ group_name }}',
  true,
  '{{ demo_tag }}: privileged cloud admins (planted for the entitlements demo)'

/*+ statecheck, retries=5, retry_delay=5 */
WITH g AS (
  SELECT id, displayName AS display_name FROM entra_id.groups.groups
)
SELECT COUNT(*) AS count FROM g WHERE display_name = '{{ group_name }}'

/*+ exports */
WITH g AS (
  SELECT id, displayName AS display_name FROM entra_id.groups.groups
)
SELECT id AS group_id FROM g WHERE display_name = '{{ group_name }}'

/*+ delete */
DELETE FROM entra_id.groups.groups
WHERE group_id = '{{ group_id }}'
